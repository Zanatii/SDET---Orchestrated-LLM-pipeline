# ── LLM Providers ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GROK_API_KEY=

# ── JIRA ──────────────────────────────────────────────────────────────────────
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_PERSONAL_ACCESS_TOKEN=

# ── Notifications ─────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
NOTIFICATION_EMAILS=

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sdet_agent

# ── S3 / MinIO ────────────────────────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=sdet-artifacts
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# ── LangSmith Tracing ─────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=sdet-multi-agent

# ── Pipeline Gate Settings ────────────────────────────────────────────────────
COVERAGE_THRESHOLD=90
GATE_AUTO_APPROVE=false
GATE_TIMEOUT_REQUIREMENTS=172800
GATE_TIMEOUT_HLS=172800
GATE_TIMEOUT_TCS=259200
GATE_TIMEOUT_COVERAGE=86400
GATE_TIMEOUT_REPORT=86400
